=== Patch file per submission ===
From 12385c63f239131b9fa710f1e947e3804e5ecca3 Mon Sep 17 00:00:00 2001
From: Francesco Cali <fracali99@gmail.com>
Date: Wed, 1 Apr 2026 13:42:29 +0200
Subject: [PATCH] wireguard: annotate timer_handshake_attempts with
 READ_ONCE/WRITE_ONCE

KCSAN reports a data-race on peer->timer_handshake_attempts between
wg_expired_retransmit_handshake() running in softirq context and
wg_packet_send_queued_handshake_initiation() running in a work queue:

  BUG: KCSAN: data-race in wg_expired_retransmit_handshake /
               wg_packet_send_queued_handshake_initiation

  write to 0xffff88810b667808 of 4 bytes by task on cpu 1:
    wg_packet_send_queued_handshake_initiation+0x... send.c:59

  read to 0xffff88810b667808 of 4 bytes by interrupt on cpu 0:
    wg_expired_retransmit_handshake+0x... timers.c:46

timer_handshake_attempts is a plain unsigned int accessed from multiple
execution contexts without locking.  The counter does not need strict
atomicity, but the unsynchronized access constitutes a data-race that is
undefined behavior in C and can trigger KCSAN warnings.

Annotate all read and write accesses with READ_ONCE()/WRITE_ONCE() to
document the intentional non-atomic concurrent access and prevent
compiler optimizations from tearing or reordering the operations.

Reported-by: syzbot+4ca9a7b9d61b76d0177c@syzkaller.appspotmail.com
Link: https://syzkaller.appspot.com/bug?extid=4ca9a7b9d61b76d0177c
Fixes: e7096c131e51 ("net: WireGuard secure network tunnel")
Signed-off-by: Francesco Cali <fracali99@gmail.com>
---
 drivers/net/wireguard/send.c   |  2 +-
 drivers/net/wireguard/timers.c | 11 ++++++-----
 2 files changed, 7 insertions(+), 6 deletions(-)

diff --git a/drivers/net/wireguard/send.c b/drivers/net/wireguard/send.c
index 26e09c30d596..6f5ed108f696 100644
--- a/drivers/net/wireguard/send.c
+++ b/drivers/net/wireguard/send.c
@@ -56,7 +56,7 @@ void wg_packet_send_queued_handshake_initiation(struct wg_peer *peer,
 						bool is_retry)
 {
 	if (!is_retry)
-		peer->timer_handshake_attempts = 0;
+		WRITE_ONCE(peer->timer_handshake_attempts, 0);
 
 	rcu_read_lock_bh();
 	/* We check last_sent_handshake here in addition to the actual function
diff --git a/drivers/net/wireguard/timers.c b/drivers/net/wireguard/timers.c
index 4016a3065602..ddcf2ad7946a 100644
--- a/drivers/net/wireguard/timers.c
+++ b/drivers/net/wireguard/timers.c
@@ -43,7 +43,7 @@ static void wg_expired_retransmit_handshake(struct timer_list *timer)
 	struct wg_peer *peer = timer_container_of(peer, timer,
 						  timer_retransmit_handshake);
 
-	if (peer->timer_handshake_attempts > MAX_TIMER_HANDSHAKES) {
+	if (READ_ONCE(peer->timer_handshake_attempts) > MAX_TIMER_HANDSHAKES) {
 		pr_debug("%s: Handshake for peer %llu (%pISpfsc) did not complete after %d attempts, giving up\n",
 			 peer->device->dev->name, peer->internal_id,
 			 &peer->endpoint.addr, (int)MAX_TIMER_HANDSHAKES + 2);
@@ -61,11 +61,12 @@ static void wg_expired_retransmit_handshake(struct timer_list *timer)
 			mod_peer_timer(peer, &peer->timer_zero_key_material,
 				       jiffies + REJECT_AFTER_TIME * 3 * HZ);
 	} else {
-		++peer->timer_handshake_attempts;
+		WRITE_ONCE(peer->timer_handshake_attempts,
+			   READ_ONCE(peer->timer_handshake_attempts) + 1);
 		pr_debug("%s: Handshake for peer %llu (%pISpfsc) did not complete after %d seconds, retrying (try %d)\n",
 			 peer->device->dev->name, peer->internal_id,
 			 &peer->endpoint.addr, (int)REKEY_TIMEOUT,
-			 peer->timer_handshake_attempts + 1);
+			 READ_ONCE(peer->timer_handshake_attempts) + 1);
 
 		/* We clear the endpoint address src address, in case this is
 		 * the cause of trouble.
@@ -195,7 +196,7 @@ void wg_timers_handshake_initiated(struct wg_peer *peer)
 void wg_timers_handshake_complete(struct wg_peer *peer)
 {
 	timer_delete(&peer->timer_retransmit_handshake);
-	peer->timer_handshake_attempts = 0;
+	WRITE_ONCE(peer->timer_handshake_attempts, 0);
 	peer->sent_lastminute_handshake = false;
 	ktime_get_real_ts64(&peer->walltime_last_handshake);
 }
@@ -230,7 +231,7 @@ void wg_timers_init(struct wg_peer *peer)
 	timer_setup(&peer->timer_persistent_keepalive,
 		    wg_expired_send_persistent_keepalive, 0);
 	INIT_WORK(&peer->clear_peer_work, wg_queued_expired_zero_key_material);
-	peer->timer_handshake_attempts = 0;
+	WRITE_ONCE(peer->timer_handshake_attempts, 0);
 	peer->sent_lastminute_handshake = false;
 	peer->timer_need_another_keepalive = false;
 }
